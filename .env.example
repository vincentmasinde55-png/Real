# Deriv OAuth 2.0 client ID from your Deriv developer dashboard
NEXT_PUBLIC_DERIV_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID

# Must exactly match the redirect URI registered in Deriv OAuth
NEXT_PUBLIC_DERIV_REDIRECT_URI=https://your-domain.com/callback

# Optional legacy V1 app id. Leave blank if you are using only the new API.
NEXT_PUBLIC_DERIV_LEGACY_APP_ID=

# Deriv API base URL
NEXT_PUBLIC_DERIV_API_BASE=https://api.derivws.com
